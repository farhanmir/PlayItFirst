# Play It First local / deploy environment
# Render-only single-service deployment: use render.yaml and same-origin networking.
# Never commit real secrets.

# --- Single Node service (Render / single-port local) ---
PORT=5173
# Local default; npm start and Render select production explicitly.
NODE_ENV=development

# Optional sponsor keys (server-side only)
COSTAR_API_URL=
COSTAR_API_KEY=
# Authorized local event extract (generated by scripts/import-costar.py).
# Copy only the vetted normalized file to Render via an authorized private mechanism.
COSTAR_DATA_FILE=
COSTAR_KIT_PATH=
COSTAR_KIT_PASSWORD=
MATTERPORT_API_KEY=
MATTERPORT_TOKEN=
MATTERPORT_SDK_KEY=
MATTERPORT_SDK_TOKEN=
# Nessie V2 sandbox only. Bearer key stays server-side.
NESSIE_KEY=
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Fictional practice rooms auto-connect when a key is present by default.
# Set true to require the owner's activation-code flow instead.
NESSIE_REQUIRE_ACTIVATION=false
NESSIE_ACCOUNT_LIMIT=3
# Required for the activation-code flow; random 32+ chars.
NESSIE_ACTIVATION_CODE=
# Only after sponsor authorizes sending real-property-derived context to banking.
ALLOW_SPONSOR_BANK_CONTEXT=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional alias; GOOGLE_API_KEY takes precedence over GEMINI_API_KEY.
GEMINI_API_KEY=
# Provider precedence: Google/Gemini, OpenAI, Anthropic. No background model polling.
# Defaults: gemini-3.6-flash / gpt-4o-mini / claude-opus-5-5 (low effort, adaptive thinking).
# Override with a tool-capable model available to your provider project.
DEEPAGENTS_MODEL=
# Enable only after sponsor authorization for external model processing.
# Otherwise imported/live sponsor rooms use local rules even with a model key.
ALLOW_SPONSOR_MODEL_CONTEXT=false


# Photon Beta iMessage: existing provisioned project/line, not automatic signup.
# Configure all four server-side. Webhook API version: 2026-07-01.
PHOTON_PROJECT_ID=
PHOTON_SENDER_ID=
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=

# In-memory demo capacity and reconnect grace (no persistent saves).
MAX_ROOMS=32
MAX_ROOM_MEMBERS=12
ROOM_ABANDON_GRACE_MS=300000
# Photon 2.0 demo inbox; all values server-side. Assign a shared/dedicated line first.
# Required for signed-webhook pairing; bounded-inbox sessions use the owner's
# room authentication and approved sender list instead.
PHOTON_ACTIVATION_CODE=
# One or more teammates' iMessage handles, comma-separated (e.g. +15551230001,+15551230002); each must also be added on the Photon iMessage page.
PHOTON_TEST_SENDER=
PHOTON_AGENT_HANDLE=
# Actual eligible telephone number (not a shared iMessage line)
PHOTON_VOICE_NUMBER=
# Generate a random 32+ character secret, also in ElevenLabs tool auth header.
PHOTON_VOICE_TOOL_SECRET=
# Only enable with explicit permission for external phone/voice processing.
ALLOW_SPONSOR_PHONE_CONTEXT=false

# Exactly one messaging ingress. Latest demo default is bounded-inbox.
# Set webhook only for signed destination delivery; polling is then disabled.
PHOTON_MESSAGING_TRANSPORT=bounded-inbox

# Grok (xAI) customer minds: each café customer gets its own Grok persona. Leave XAI_API_KEY empty to keep scripted customers.
XAI_API_KEY=
XAI_MODEL=grok-4.20-non-reasoning
CUSTOMER_MINDS=on
CUSTOMER_MINDS_MAX_IN_FLIGHT=3
