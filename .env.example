# Play It First local / deploy environment
# Render single-service: use render.yaml; leave frontend origin overrides unset.
# Optional split hosting: backend secrets on Render/Railway; public origins on Vercel.
# Never commit real secrets.

# --- Single Node backend (Render / Railway / single-port local) ---
PORT=5173
NODE_ENV=production
# Browser origins allowed to call this API when the Vite app is on another host.
# Example: https://softopen.vercel.app
CORS_ORIGINS=
FRONTEND_ORIGIN=

# Optional sponsor keys (server-side only)
COSTAR_API_URL=
COSTAR_API_KEY=
# Authorized local event extract (generated by scripts/import-costar.py).
# Copy only the vetted normalized file to Render via an authorized private mechanism.
COSTAR_DATA_FILE=
COSTAR_KIT_PATH=
COSTAR_KIT_PASSWORD=
MATTERPORT_API_KEY=
MATTERPORT_TOKEN=
MATTERPORT_SDK_KEY=
MATTERPORT_SDK_TOKEN=
NESSIE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional alias; GOOGLE_API_KEY takes precedence over GEMINI_API_KEY.
GEMINI_API_KEY=
# Provider precedence: Google/Gemini, OpenAI, Anthropic. No background model polling.
# Defaults: gemini-3.6-flash / gpt-4o-mini / claude-haiku-4-5-20251001.
# Override with a tool-capable model available to your provider project.
DEEPAGENTS_MODEL=
# Enable only after sponsor authorization for external model processing.
# Otherwise imported/live sponsor rooms use local rules even with a model key.
ALLOW_SPONSOR_MODEL_CONTEXT=false

# --- Vercel frontend (public build-time only; no secrets) ---
# Leave empty for same-origin local single-port `npm run dev`.
VITE_API_BASE_URL=
VITE_WS_URL=
# Public site origin used when minting QR invites from a static host.
VITE_PUBLIC_ORIGIN=
