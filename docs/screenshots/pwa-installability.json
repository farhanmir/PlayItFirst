{
  "manifest": {
    "id": "/",
    "name": "Play It First",
    "short_name": "Play It First",
    "description": "Play your café before you open it. An online multiplayer business game.",
    "lang": "en",
    "start_url": "/?source=pwa",
    "scope": "/",
    "display": "standalone",
    "background_color": "#173c35",
    "theme_color": "#173c35",
    "categories": [
      "games",
      "simulation"
    ],
    "icons": [
      {
        "src": "/icons/app-192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "any maskable"
      },
      {
        "src": "/icons/app-512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "any maskable"
      }
    ]
  },
  "mime": "application/manifest+json; charset=utf-8",
  "icons": [
    {
      "src": "/icons/app-192.png",
      "width": 192,
      "height": 192
    },
    {
      "src": "/icons/app-512.png",
      "width": 512,
      "height": 512
    }
  ],
  "caches": [
    {
      "name": "playitfirst-offline-v1",
      "urls": [
        "/offline.html"
      ]
    }
  ],
  "controller": "http://localhost:5391/sw.js",
  "installability": {
    "installabilityErrors": []
  },
  "offlineFallback": true,
  "reconnect": true,
  "pageErrors": []
}
